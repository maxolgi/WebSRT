#!/bin/sh
# postinst — create runtime dirs after .deb install.
set -e

mkdir -p /var/lib/websrt /var/log/websrt

# Reload supervisord so it picks up the shipped config, if supervisord is running.
if command -v supervisorctl >/dev/null 2>&1; then
    supervisorctl reread  >/dev/null 2>&1 || true
    supervisorctl update  >/dev/null 2>&1 || true
fi

#DEBHELPER#
exit 0
