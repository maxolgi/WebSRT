/target
**/target
**/*.rs.bk

# wasm-pack output
**/pkg/

# node
web/node_modules/
web/dist/

# wasm-pack output copied to web/ (regenerated by build commands)
web/wasm/

# certs (mkcert mode)
certs/*.pem
certs/*.crt
certs/*.key
# root-level certs/keys (never commit private keys)
/*.pem
/*.key
/*.crt

# runtime-generated cert hash (written by gateway on boot)
web/public/cert-hash.js

# runtime-generated gateway certs/keys (self-signed mode)
.config/

fixtures/*.ts

# logs and tmp
logs/
tmp/

# local scratch/planning notes — reused, not history; never commit
/plan.md
/call-plan.md
